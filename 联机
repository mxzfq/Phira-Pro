.github/workflows/build-mp-apk.yml
name: 零环境出APK（联机版）

# 全程在 GitHub 的 runner 上编译，本机不需要装任何东西。
# 用法：把本文件放到 fork 的默认分支（网页新建文件即可），
#       然后 Actions → 本工作流 → Run workflow → 下载 Artifact。
on:
  workflow_dispatch:

jobs:
  apk:
    name: 联机版 APK（arm64-v8a）
    runs-on: ubuntu-latest
    timeout-minutes: 120
    permissions:
      contents: read

    steps:
      # 这是「移除联机前的最后一个版本」：自带完整 pro.17 联机，
      # 且当时还没有加入官方签名证书校验，所以无需任何补丁。
      - uses: actions/checkout@v7.0.1
        with:
          ref: 04ff1dc176461c24ebf0e3c8b0c790f4e4148bbb
          fetch-depth: 1

      - uses: actions/setup-python@v7.0.0
        with:
          python-version: '3.12'

      - name: Verify versions
        run: python scripts/version.py check

      - name: Set up JDK 21
        uses: actions/setup-java@v6.0.1
        with:
          distribution: temurin
          java-version: '21'

      - name: Verify multi-finger input routing
        run: python scripts/verify_android_multitouch.py

      # runner 预装 Android SDK / cmdline-tools，这里只补齐 platform / build-tools / NDK
      - name: Install Android SDK components
        run: |
          set -e
          SDK="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-/usr/local/lib/android/sdk}}"
          echo "Android SDK: $SDK"
          SDKMGR="$SDK/cmdline-tools/latest/bin/sdkmanager"
          if [ ! -x "$SDKMGR" ]; then SDKMGR="$(command -v sdkmanager)"; fi
          yes | "$SDKMGR" --licenses > /dev/null || true
          "$SDKMGR" --install "platforms;android-35" "build-tools;35.0.0" "platform-tools" "ndk;27.2.12479018"
          echo "ANDROID_NDK_HOME=$SDK/ndk/27.2.12479018" >> "$GITHUB_ENV"

      # rust-toolchain.toml 锁定 nightly-2026-01-01
      - name: Set up Rust
        run: |
          rustup toolchain install
          rustup target add aarch64-linux-android
          cargo install cargo-ndk --locked

      - name: Cache
        uses: actions/cache@v6.1.0
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
            prpr-avc/static-lib
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: android-${{ runner.os }}-${{ hashFiles('Cargo.lock', 'prpr-avc/ffmpeg-version') }}
          restore-keys: android-${{ runner.os }}-

      - name: Make gradlew executable
        run: chmod +x phira-android/gradlew

      # 关键：不依赖任何组织级 Secret，在 runner 上现场生成自签证书。
      # Gradle 从这四个环境变量读取签名信息；证书随 runner 销毁。
      - name: 生成临时签名证书（无需 Secret）
        run: |
          set -e
          PW="$(python3 -c 'import secrets; print(secrets.token_hex(16))')"
          KS="$RUNNER_TEMP/phirapro.p12"
          keytool -genkeypair -v \
            -keystore "$KS" -storetype PKCS12 -alias phirapro \
            -keyalg RSA -keysize 2048 -validity 10000 \
            -storepass "$PW" -keypass "$PW" \
            -dname "CN=Phira-Pro Custom Build, OU=Custom, O=Custom, L=NA, S=NA, C=CN" > /dev/null 2>&1
          {
            echo "PHIRA_PRO_KEYSTORE_PATH=$KS"
            echo "PHIRA_PRO_KEYSTORE_PASSWORD=$PW"
            echo "PHIRA_PRO_KEY_ALIAS=phirapro"
            echo "PHIRA_PRO_KEY_PASSWORD=$PW"
          } >> "$GITHUB_ENV"
          cp "$KS" "$GITHUB_WORKSPACE/custom-signing.p12"
          echo "已生成临时签名证书；该版本不含官方证书校验，任意有效签名即可启动。"

      - name: Build release APK
        working-directory: phira-android
        run: ./gradlew assembleRelease --no-daemon

      - name: Verify APK signature
        working-directory: phira-android
        run: |
          set -e
          APK=$(ls app/build/outputs/apk/release/*.apk | head -n 1)
          SDK="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-/usr/local/lib/android/sdk}}"
          "$SDK/build-tools/35.0.0/apksigner" verify --print-certs "$APK"

      - name: Name release APK
        run: |
          set -euo pipefail
          VERSION="$(python scripts/version.py show --field pro_version)"
          mkdir -p dist/android
          cp phira-android/app/build/outputs/apk/release/app-release.apk \
             "dist/android/PhiraPro-v${VERSION}-mp-android-arm64-v8a.apk"
          # 附上本次签名密钥，方便以后用同一把钥匙覆盖安装（请只保存在自己设备上）
          cp custom-signing.p12 dist/android/signing-keystore.p12

      - name: Upload APK
        uses: actions/upload-artifact@v7.0.1
        with:
          name: PhiraPro-联机版-APK
          path: dist/android/*
          compression-level: 0
          if-no-files-found: error
